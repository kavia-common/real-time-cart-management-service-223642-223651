# MongoDB Configuration
# REQUIRED: MongoDB Atlas connection URI
# Example: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# REQUIRED: MongoDB database name
# Example: cart_management
MONGODB_DATABASE=

# JWT Authentication Configuration
# REQUIRED: Secret key for JWT token signing (minimum 32 characters)
# Generate a secure random string for production
# Example: openssl rand -hex 32
JWT_SECRET_KEY=

# JWT algorithm (default: HS256)
JWT_ALGORITHM=HS256

# JWT token expiration in minutes (default: 30)
JWT_EXPIRATION_MINUTES=30

# Application Environment
ENVIRONMENT=development

# Existing Configuration (already in .env)
BACKEND_URL=https://vscode-internal-38347-beta.beta01.cloud.kavia.ai:3001
FRONTEND_URL=https://vscode-internal-38347-beta.beta01.cloud.kavia.ai:3000
WS_URL=ws://vscode-internal-38347-beta.beta01.cloud.kavia.ai:3001/ws
SITE_URL=https://vscode-internal-38347-beta.beta01.cloud.kavia.ai:3000
ALLOWED_ORIGINS=https://vscode-internal-38347-beta.beta01.cloud.kavia.ai:3000,http://localhost:3000,http://localhost:4000
ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_MAX_AGE=3600
COOKIE_DOMAIN=.vscode-internal-38347-beta.beta01.cloud.kavia.ai
TRUST_PROXY=true
HOST=0.0.0.0
UVICORN_HOST=0.0.0.0
UVICORN_WORKERS=1
NODE_ENV=development
REQUEST_TIMEOUT_MS=30000
RATE_LIMIT_WINDOW_S=60
RATE_LIMIT_MAX=100
PORT=3001
